a5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r5_1_04.mp4",39.04,41.8],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r7_1_04.mp4",7.68,11.3],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r1_1_05.mp4",5.0,7.38],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_03.mp4",8.92,12.98],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_03.mp4",13.0,13.7],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r2_2_03.mp4",10.9,14.3],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_03.mp4",14.5,19.06],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_04.mp4",2.86,11.52],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r2_1_03.mp4",37.34,39.8],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r5_1_04.mp4",14.44,17.34],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_04.mp4",13.44,16.8],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_05.mp4",4.0,7.04],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r2_2_01.mp4",48.74,53.92],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_05.mp4",17.86,22.26],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r1_2_04.mp4",12.94,18.46],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_05.mp4",25.02,28.2],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r7_2_03.mp4",39.58,41.9],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_01.mp4",0.0,75.0],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_02.mp4",0.0,75.0],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_03.mp4",0.0,75.0],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_04.mp4",0.0,75.0],["https://pub-461f2400791f4f4ea5c7a14ea96c96cf.r2.dev/tb/c/s1/p34m_r3_2_05.mp4",0.0,70.06]],"t":[["1–3번 담화",29],["4–6번 담화",30],["7–9번 담화",31],["10–12번 담화",32],["13–15번 담화",33]],"q":[{"n":"P4-1","a":1,"k":4,"ex":"화자는 누구에게 연설하고 있습니까?\n(A) 심리학자 협회\n(B) 신입 사원 ✔\n(C) 잠재 고객\n(D) 광고 회사\n정답 (B) · Welcome to our new associates orientation program — 청 중은 신입 직원이다.\n오답은 왜 오답인가\n(A) 화자 개인의 학위가 심리학일 뿐 청중과 무관하다.\n(C) 보험 고객은 major corporations로 따로 언급된다.\n(D) 광고 회사는 등장하지 않는다.\n틀렸다면 · 화자의 이력(심리학 학위)을 청중의 정체로 옮겨 붙인 오답이 (A) 다. 파트4에서는 '누가 말하는가'와 '누가 듣는가'를 처음 두 문장 안에서 분리해 두는 것이 원칙이다.","tr":""},{"n":"P4-2","a":2,"k":4,"ex":"화자는 회사에 대해 뭐라고 하는가?\n(A) 다른 나라들로 확장되고 있다\n(B) 설립 7년이 되었다\n(C) 많은 돈을 번다 ✔\n(D) 혜택을 늘렸다\n정답 (C) · our annual earnings are the highest in the industry — 업계 최고 수익이라는 말이 '많은 돈을 번다'로 요약된다.\n오답은 왜 오답인가\n(A) 이미 5개 대륙에서 영업 중이며, 지금 확장한다는 말은 없다. 현재 상태를 진행 계획으로 바꾼 오답.\n(B) 7년은 화자의 근속 연수이지 회사의 연혁이 아니다.\n(D) 복리후생 언급 없음.\n틀렸다면 · 숫자가 나오면 그 숫자의 주인을 반드시 확인해야 한다. seven years는 회사가 아니라 화자의 것이었다 — 이 한 번의 오배정이 오답 하나를 만 든다.","tr":""},{"n":"P4-3","a":1,"k":4,"ex":"청중은 다음에 무엇을 할 것인가?\n(A) 아침을 먹는다\n(B) 자기소개를 한다 ✔\n(C) 둘러본다\n(D) 질문한다\n정답 (B) · Why don't those of you in the back row introduce yourselves first? Please stand up… — 마지막 지시가 다음 행동이다.\n오답은 왜 오답인가\n(A) 식사 언급 없음.\n(C) 견학은 나오지 않는다.\n(D) 질문 시간도 언급되지 않는다.\n틀렸다면 · Why don't you…?는 제안이자 사실상 지시다. 의문문이라 정보 가 아니라고 판단해 흘려보내면, 정답이 물음표 뒤에서 지나가 버린다.","tr":""},{"n":"P4-4","a":3,"k":4,"ex":"화자에 따르면, 시장 조사는 무엇을 보여주는가?\n(A) 고객들은 집 가까운 곳에서 쇼핑하기를 선호한다\n(B) 대부분의 식당에는 구운 디저트가 있다\n(C) 음식 잡지는 매우 인기가 많다\n(D) 질 좋은 디저트는 판매가 좋다 ✔\n정답 (D) · market research shows that premium-quality desserts are selling very well — shows that 뒤가 곧 조사 결과다.\n오답은 왜 오답인가\n(A) 오히려 소비자들이 멀리까지 찾아간다고 했다. 정반대 진술.\n(B) 식당 이야기는 없다.\n(C) 잡지는 유명세를 설명하는 예시일 뿐 조사 결과가 아니다.\n틀렸다면 · (A)는 지문의 내용을 뒤집은 오답이다. go out of their way를 흘 려들으면 상식적으로 그럴듯한 (A)가 정답처럼 보인다. 익숙한 진술일수록 근거 를 되짚어야 한다.","tr":""},{"n":"P4-5","a":1,"k":4,"ex":"누가 이 발표의 청중일 것인가?\n(A) 페이스트리 요리사\n(B) 식료품점 매니저 ✔\n(C) 식당 주인\n(D) 요리 강사\n정답 (B) · at a local grocery store, at your store + 전국 식료품 박람회 — 청중은 식료품점 운영자다.\n오답은 왜 오답인가\n(A) 제품을 만드는 사람은 테드 넬슨 쪽이다.\n(C) 식당은 언급되지 않는다.\n(D) 요리 강좌도 나오지 않는다. cooking show와 혼동한 오답.\n틀렸다면 · your store라는 소유격 두 글자가 청중을 확정한다. 파트4에서 you/your가 붙은 명사는 곧 청중의 정체다 — 이 단서를 놓치면 업종 단어들 사 이에서 헤매게 된다.","tr":""},{"n":"P4-6","a":1,"k":4,"ex":"화자는 다음에 무엇을 할 것 같습니까?\n(A) 새 광고를 발표한다\n(B) 디저트 샘플을 나눠 준다 ✔\n(C) 가게를 구경한다\n(D) 베이킹 기술을 가르쳐 준다\n정답 (B) · Today, we'd like to share some Ted Nelson pastry with you — 마지막 문장의 예고가 다음 행동이다.\n오답은 왜 오답인가\n(A) 광고 발표는 언급 없음.\n(C) 매장 방문 계획도 없다.\n(D) 제빵 강습이 아니라 시식 제공이다.\n틀렸다면 · we'd like to는 파트4에서 '지금부터 할 일'을 알리는 문장이다. 앞 의 시장 조사·유명세 설명에 집중력을 다 쓰고 마지막 문장을 흘리면, 정작 배점 이 걸린 정보를 놓친다.","tr":""},{"n":"P4-7","a":0,"k":4,"ex":"통화 목적이 무엇입니까?\n(A) 제품을 제안하려고 ✔\n(B) 주문을 취소하려고\n(C) 주소를 제공하려고\n(D) 주소를 요청하려고\n정답 (A) · we'd like to know if you'd be interested in ordering a flat- screen monitor — 추가 상품을 권하는 영업 전화다.\n오답은 왜 오답인가\n(B) 취소가 아니라 추가 주문 권유다. 정반대.\n(C) 주소 안내는 나오지 않는다.\n(D) 주소 요청도 없다. 배송은 이미 진행 중이다.\n틀렸다면 · 목적 문제에서 I'm calling about은 '주제'만 알려 준다. 진짜 목적 은 그다음 문장(we'd like to know if…)에 있다 — 두 문장을 한 세트로 들어야 하는 이유다. M A K E T O E I C · 김 정 수 메 이 크 토 익 파트3&4 3회 · 정답 및 해설 34","tr":""},{"n":"P4-8","a":3,"k":4,"ex":"전화를 건 사람은 스톡턴 씨에 대해 뭐라고 하던가요?\n(A) 디지털 카메라를 가지고 있다\n(B) 전화를 많이 받는다\n(C) 설문조사에 참여했다\n(D) 단골손님이다 ✔\n정답 (D) · this is your tenth purchase… a special deal for our customers like you — 열 번째 구매 고객, 즉 단골이다.\n오답은 왜 오답인가\n(A) 카메라는 언급 없음.\n(B) 통화량 이야기도 없다.\n(C) 설문조사는 나오지 않는다.\n틀렸다면 · tenth purchase → regular customer. 숫자를 성격 묘사로 바꾸 는 전형적 패러프레이즈다. 숫자를 들으면 그 숫자가 무엇을 '의미하는지'까지 한 걸음 더 나아가야 한다.","tr":""},{"n":"P4-9","a":1,"k":4,"ex":"전화를 건 사람은 어떻게 하겠다고 했어요?\n(A) 카탈로그를 보낸다\n(B) 나중에 다시 전화한다 ✔\n(C) 시스템을 복구한다\n(D) 새 모니터를 발송한다\n정답 (B) · I'll try to reach you again later today — 마지막 문장이 곧 예고 된 행동이다.\n오답은 왜 오답인가\n(A) 카탈로그는 무료 상품을 고르는 수단으로 언급될 뿐 발송 대상이 아니다.\n(C) 시스템 복구는 등장하지 않는다.\n(D) 모니터 발송은 고객이 수락해야 성립하는 미확정 사안이다.\n틀렸다면 · (D)처럼 '가능성만 언급된 일'을 확정된 행동으로 고르는 실수가 잦 다. 조건(if you'd be interested)이 붙은 문장은 정답이 되지 못한다는 원칙을 기억해야 한다.","tr":""},{"n":"P4-10","a":3,"k":4,"ex":"어떤 제품이 논의되고 있나요?\n(A) 스테레오 시스템\n(B) 노트북 컴퓨터\n(C) 컬러 프린터\n(D) 소프트웨어 프로그램 ✔\n정답 (D) · our latest data security software… this outstanding software package — 제품이 두 번 명시된다.\n오답은 왜 오답인가\n(A) 오디오 기기는 등장하지 않는다.\n(B) 컴퓨터 하드웨어 이야기가 아니다.\n(C) 프린터도 언급 없음.\n틀렸다면 · 제품 문제는 대개 두 번 이상 반복되는 명사가 답이다. 한 번도 반복 되지 않은 선택지는 애초에 후보가 아니라는 감각을 가져야 한다.","tr":""},{"n":"P4-11","a":2,"k":4,"ex":"아오키 코지에 대해서는 뭐라고 하는가?\n(A) 산업 잡지에서 일한다\n(B) 영향력 있는 광고 캠페인을 만들었다\n(C) 성공적인 프로젝트 팀을 이끌었다 ✔\n(D) 이사회에 소속되어 있다\n정답 (C) · Mr. Koju Aoki, who led the team of engineers that created this outstanding software package — 관계대명사절이 그의 역할을 설명한 다.\n오답은 왜 오답인가\n(A) 잡지는 상을 준 쪽이다. 인물과 기관을 뒤바꾼 오답.\n(B) 광고 캠페인은 언급 없음.\n(D) 이사회 이야기도 나오지 않는다.\n틀렸다면 · 인물 문제의 근거는 이름 바로 뒤 who절에 있다. 이름이 어렵게 들 려 순간 멈추면 정작 중요한 뒷부분을 통째로 놓친다 — 이름은 소리로만 흘리고 뒤 절에 집중해야 한다. M A K E T O E I C · 김 정 수 메 이 크 토 익 파트3&4 3회 · 정답 및 해설 35","tr":""},{"n":"P4-12","a":1,"k":4,"ex":"그 회사는 내년에 무엇을 할 계획인가요?\n(A) 컨설턴트 고용\n(B) 해외 사무소 개설 ✔\n(C) 로고 변경\n(D) 부서 재편성\n정답 (B) · the company plans to open an office abroad next year — 계 획이 직접 제시된다.\n오답은 왜 오답인가\n(A) 채용 계획은 언급 없음.\n(C) 로고 변경도 나오지 않는다.\n(D) 조직 개편 역시 없다.\n틀렸다면 · plans to, will, is going to 뒤가 미래 계획 문제의 자리다. 앞의 수 상 소식에 감정을 실어 듣다 보면 마지막 정보가 흐려진다 — 담화의 후반부일수 록 오히려 힘을 줘야 한다.","tr":""},{"n":"P4-13","a":0,"k":4,"ex":"내일 날씨는 어떻게 변할까요?\n(A) 더 추워질 것이다 ✔\n(B) 비가 오기 시작할 것이다\n(C) 안개가 낄 것이다\n(D) 더 화창할 것이다\n정답 (A) · Starting tomorrow morning, temperatures will drop dramatically — 기온 하강이 곧 '더 추워진다'이다.\n오답은 왜 오답인가\n(B) 비가 아니라 눈이다. 강수 형태를 바꾼 오답.\n(C) 안개는 언급 없음.\n(D) 화창한 날씨는 '오늘'이었다. 시점을 뒤집은 함정.\n틀렸다면 · 일기예보 지문은 오늘·내일·토요일·일요일이 줄줄이 나온다. 요 일 옆에 날씨를 한 글자로 적어 두는 것만으로 세 문제 중 두 문제가 해결된다.","tr":""},{"n":"P4-14","a":1,"k":4,"ex":"화자는 사람들에게 내일 무엇을 하라고 조언하는가?\n(A) 우산을 가지고 다닌다\n(B) 운전을 조심한다 ✔\n(C) 두꺼운 코트를 입는다\n(D) 라디오를 듣는다\n정답 (B) · The roads will be slippery, so please drive slowly — please 뒤가 조언이다.\n오답은 왜 오답인가\n(A) 눈 예보이므로 우산은 근거가 없다. 상식으로 채운 오답.\n(C) 기온 하강은 언급되지만 옷차림 조언은 하지 않았다. 그럴듯하지만 근거 없음.\n(D) 방송을 계속 들으라는 말은 keep you posted 정도이며 조언 대상이 아 니다.\n틀렸다면 · (C)처럼 '지문에서 유추 가능하지만 말하지 않은 것'이 파트4의 가 장 정교한 오답이다. 조언 문제의 근거는 반드시 명령·요청 문장이어야 한다.","tr":""},{"n":"P4-15","a":2,"k":4,"ex":"청취자들은 다음에 무엇을 듣게 될까요?\n(A) 교통 보고서\n(B) 약간의 음악\n(C) 뉴스 보도 ✔\n(D) 일부 광고\n정답 (C) · let's go right to Ann Martin for an update on today's top international news stories — 다음 순서가 명시된다.\n오답은 왜 오답인가\n(A) 교통 정보는 언급 없음.\n(B) 음악도 나오지 않는다.\n(D) 광고 역시 예고되지 않았다.\n틀렸다면 · 방송 지문의 마지막 문장은 예외 없이 '다음 순서'다. 이 규칙 하나만 알아도 15번 유형은 지문 내용과 상관없이 확보할 수 있다. M A K E T O E I C · 김 정 수 메 이 크 토 익 파트3&4 3회 · 정답 및 해설 36","tr":""}],"ps":[],"qp":[[0.1485,0.1929,0.2617],[0.1641,0.2656,0.2617],[0.133,0.3383,0.2617],[0.1885,0.4274,0.2617],[0.1406,0.5001,0.2617],[0.1583,0.5728,0.2617],[0.1355,0.6611,0.97],[0.1502,0.7338,0.97],[0.1277,0.8065,0.97],[0.3429,0.1929,0.5453],[0.4134,0.2656,0.5442],[0.364,0.3383,0.5442],[0.3451,0.4274,0.5442],[0.3392,0.5001,0.5442],[0.3492,0.5728,0.97]]}